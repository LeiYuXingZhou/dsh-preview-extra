{
  "name": "dsh-preview-extra",
  "version": "0.1.0",
  "description": "DSH web plugin: extra right-sidebar document previews for 3D models (STL/OBJ/PLY/glTF/GLB), archives, media, fonts, subtitles, TOML, Intel HEX, JCAMP-DX, VCD, KiCad and DFU.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "document-preview",
    "3d",
    "stl",
    "obj",
    "ply",
    "archive",
    "zip",
    "font",
    "subtitle",
    "gltf",
    "glb",
    "toml",
    "kicad",
    "dfu",
    "intel-hex",
    "jcamp",
    "vcd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeiYuXingZhou/dsh-preview-extra.git"
  },
  "homepage": "https://github.com/LeiYuXingZhou/dsh-preview-extra#readme",
  "bugs": {
    "url": "https://github.com/LeiYuXingZhou/dsh-preview-extra/issues"
  },
  "license": "MIT"
}
